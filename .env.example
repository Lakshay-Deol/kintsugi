# Copy to .env and fill in real values. NEVER commit .env.
# Every config lives here — zero hardcoded values in code.

# ============================================================
# MONGODB ATLAS
# ============================================================
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=kintsugi
MONGODB_MANUALS_COLLECTION=manuals
MONGODB_CHUNKS_COLLECTION=chunks
MONGODB_ERROR_CODES_COLLECTION=error_codes
MONGODB_FIX_OUTCOMES_COLLECTION=fix_outcomes
MONGODB_INGEST_JOBS_COLLECTION=ingest_jobs
ATLAS_VECTOR_INDEX=vector_index
ATLAS_SEARCH_INDEX=bm25_index

# ============================================================
# LLM — Google AI Studio / Gemma (PRIMARY)
# ============================================================
LLM_API_KEY=AIzaSy_PLACEHOLDER
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemma-3-27b-it
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_RETRY_BASE_SECONDS=1.0
LLM_MAX_TOKENS=2048

# ============================================================
# LLM — NVIDIA NIM (FALLBACK 1)
# ============================================================
# NIM_API_KEY=nvapi-PLACEHOLDER
# NIM_BASE_URL=https://integrate.api.nvidia.com/v1
# NIM_MODEL=google/gemma-3-27b-it

# ============================================================
# LLM — Ollama local (FALLBACK 2 / model-swap eval arm)
# ============================================================
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_API_KEY=ollama
# OLLAMA_MODEL=gemma3:12b

# ============================================================
# EMBEDDINGS — Option A: fastembed ONNX (PRIMARY)
# ============================================================
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMS=384
SKIP_EMBEDDER_WARMUP=

# ============================================================
# EMBEDDINGS — Option B: hosted API (FALLBACK if A OOM)
# ============================================================
# EMBED_API_KEY=PLACEHOLDER
# EMBED_API_URL=PLACEHOLDER
# EMBED_API_MODEL=PLACEHOLDER

# ============================================================
# RETRIEVAL GATES (calibrated on dev split — see docs/decisions.md)
# ============================================================
MIN_VECTOR_SCORE=0.70
MIN_BM25_SCORE=5.0
RRF_K=60
VECTOR_TOP_K=10
BM25_TOP_K=10
FINAL_TOP_K=5

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PER_IP=5
RATE_LIMIT_GLOBAL=20
RATE_LIMIT_WINDOW_SECONDS=60

# ============================================================
# API SERVER
# ============================================================
API_HOST=0.0.0.0
API_PORT=8080
API_ADMIN_KEY=

# ============================================================
# APP ENVIRONMENT
# ============================================================
APP_ENV=development
DEMO_MODE=true
